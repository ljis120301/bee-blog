# BeeBlog Environment Configuration Template
# Copy this to .env and fill in your values
# ==========================================

# Database (SQLite with WAL mode)
DATABASE_URL="file:./prisma/blog.db"

# Session Security (generate with: openssl rand -base64 32)
SESSION_SECRET="your-32-character-random-secret-here"

# Admin Account (ensures admin access on every startup)
# Both are required — the ensure-admin script creates/resets the admin on boot
ADMIN_EMAIL="your-admin@email.com"
ADMIN_PASSWORD="your-secure-password-here"

# File Uploads
UPLOAD_DIR="public/uploads"
